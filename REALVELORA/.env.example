# ── Database (required) ───────────────────────────────────────────────────────
# Provided automatically by Railway when you add a PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── App secrets (required) ────────────────────────────────────────────────────
# Set to a long random string — protects the super-admin dashboard
SUPERADMIN_SECRET=change_me_to_a_long_random_string

# ── Twilio SMS (optional — SMS features disabled if not set) ──────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ── Resend email (optional — analytics emails disabled if not set) ────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Wavit Analytics <analytics@yourdomain.com>

# ── App links (optional) ──────────────────────────────────────────────────────
APP_DOWNLOAD_LINK=https://your-app.up.railway.app

# ── Capacitor / native app build (required only when building iOS/Android) ────
# Set this to your Railway deployment URL so the native app knows where the API is
# VITE_API_URL=https://your-app.up.railway.app

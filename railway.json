{
  "$schema": "https://railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd REALVELORA && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "node REALVELORA/server/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/api/shops",
    "healthcheckTimeout": 300
  }
}
